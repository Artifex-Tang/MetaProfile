# 云上只读部署凭据(.env.example 是模板,可入库)
# 用法:cp deploy/cloud/.env.example deploy/cloud/.env  → 填真值
# deploy/cloud/.env 已被 .gitignore 忽略,不会入库

# ── SSH 连接云主机 ──
SSH_HOST=
SSH_PORT=22
SSH_USER=
SSH_PASSWORD=
# 或用密钥(与 SSH_PASSWORD 二选一):
# SSH_KEY_PATH=

# ── 云上容器密码(首次部署你自己定,记住) ──
PG_PASSWORD=
NEO4J_PASSWORD=

# ── MCP 服务(7 个独立端点 /mcp/<slug>,共 37 个只读工具) ──
# Bearer token:deploy.sh 首次部署自动生成并写回本文件。留空 = 不鉴权。
MCP_AUTH_TOKEN=

# ── MCP Host 白名单 ──
# 留空 = 不校验 Host(默认)。填部署域名则只放行该 Host(逗号分隔多个)。
# 注意:经 nginx 反代时 Host 是浏览器/客户端请求的域名,填错会全线 421。
MCP_ALLOWED_HOSTS=

# ── HTTPS(enable_https.sh 用,非 compose 变量) ──
# 域名需已解析到本机公网 IP;大陆节点还需完成 ICP 备案,否则 80/443 被拦
HTTPS_DOMAIN=
HTTPS_EMAIL=

# ── OSS 中转数据(可选)──
# 数据小可直接 scp 直传(留空以下字段即跳过 OSS,走 scp)
OSS_ACCESS_KEY=
OSS_SECRET_KEY=
OSS_BUCKET=
OSS_REGION=cn-hangzhou
