# HTTPS 形态模板 —— enable_https.sh 把 __DOMAIN__ 替换成实际域名后写入 default.conf。
# 证书路径对应 certbot 的 --config-dir /etc/letsencrypt 输出,挂在 /etc/nginx/certs。
server {
    listen 80;
    server_name __DOMAIN__;

    # 续期用:certbot renew 仍走 HTTP-01,这条必须留在 80 且不能被 301 吃掉
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name __DOMAIN__;

    ssl_certificate     /etc/nginx/certs/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/live/__DOMAIN__/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # HSTS:确认 HTTPS 稳定后再放开(一旦下发,浏览器会在 max-age 内拒绝走 HTTP,回退代价高)
    # add_header Strict-Transport-Security "max-age=31536000" always;

    include /etc/nginx/conf.d/locations.inc;
}
